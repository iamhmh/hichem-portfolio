# ---------------------------------------------------------------------------
# Token GitHub, utilisé UNIQUEMENT côté serveur.
#
# Les dépôts épinglés et le calendrier de contributions ne sont exposés que par
# l'API GraphQL de GitHub, qui exige une authentification même pour des données
# publiques (il n'existe aucun équivalent REST). Sans ce token, la section
# Projets est simplement masquée et le reste du site fonctionne normalement.
#
# Création — https://github.com/settings/tokens
#   Type    : « Tokens (classic) »
#   Scope   : read:user  — et RIEN d'autre
#             (suffit pour les dépôts publics épinglés et les contributions ;
#              ne donne aucun droit d'écriture ni accès aux dépôts privés)
#   Expiration : 1 an, à renoter dans votre agenda
#
# Vérifiez le token AVANT de déployer :
#   curl -s -H "Authorization: Bearer VOTRE_TOKEN" -X POST https://api.github.com/graphql \
#     -d '{"query":"{viewer{login} user(login:\"iamhmh\"){pinnedItems(first:6,types:REPOSITORY){totalCount} contributionsCollection{contributionCalendar{totalContributions}}}}"}'
#   Une réponse contenant totalCount et totalContributions = tout est bon.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# Compte dont on affiche les données.
GITHUB_LOGIN=iamhmh

# ---------------------------------------------------------------------------
# GitLab — entièrement optionnel, AUCUN token nécessaire.
#
# Le calendrier de contributions est lu sur /users/<login>/calendar.json, la
# même source que la page de profil GitLab. Laissez GITLAB_LOGIN vide pour
# désactiver : le calendrier s'affiche alors en vert seul.
#
# Pour que vos contributions sur projets PRIVÉS y figurent, activez dans GitLab
# Préférences → Profil → « Inclure les contributions privées sur mon profil ».
# Seuls les compteurs deviennent publics, ni les noms de projets ni les commits.
# GitLab met ce calendrier en cache : comptez quelques heures avant qu'il se
# remplisse.
# ---------------------------------------------------------------------------
GITLAB_LOGIN=iamhmh

# Facultatif : instance GitLab auto-hébergée.
# GITLAB_URL=https://gitlab.example.com

# Facultatif : surcharge de l'endpoint GraphQL (tests, GitHub Enterprise).
# GITHUB_API_URL=https://api.github.com/graphql
